                category: 'Python',
                question: 'O que faz o gerenciador de contexto "with" em Python?',
                questionCode: 'with open("arquivo.txt", "r") as f:\n    conteudo = f.read()',
                answer: 'Garante que os recursos sejam gerenciados e liberados adequadamente após a conclusão (ex: fechar arquivos automaticamente), mesmo se ocorrerem erros no código.',
                answerCode: '',
                difficulty: null,
                mastered: false
            }
        ];

        // Mapeamento de Cores e Gradientes Vibrantes por Categoria
        const categoryThemes = {
            'JavaScript': {
                bg: 'bg-gradient-to-br from-amber-500 via-amber-600 to-yellow-700',
            },
            'Python': {
                bg: 'bg-gradient-to-br from-blue-600 via-indigo-600 to-sky-800',
            },
            'HTML/CSS': {
                bg: 'bg-gradient-to-br from-orange-500 via-rose-600 to-pink-700',
            },
            'React': {
                bg: 'bg-gradient-to-br from-cyan-500 via-teal-600 to-slate-800',
            },
            'Lógica de Programação': {
                bg: 'bg-gradient-to-br from-purple-600 via-indigo-700 to-violet-900',
            },
            'Default': {
                bg: 'bg-gradient-to-br from-slate-700 via-slate-800 to-slate-900',
            }
        };

        // Estado da Aplicação
        let cards = [];
        let filteredCards = [];
        let currentIndex = 0;
        let isFlipped = false;
        let activeCategory = 'Todos';

        // Elementos do DOM
        const cardInner = document.getElementById('card-inner');
        const cardFront = document.getElementById('card-front');
        const cardBack = document.getElementById('card-back');
        const cardQuestion = document.getElementById('card-question');
        const cardQuestionCode = document.getElementById('card-question-code');
        const cardAnswer = document.getElementById('card-answer');
        const cardAnswerCode = document.getElementById('card-answer-code');
        const cardCategoryBadge = document.getElementById('card-category-badge');
        const cardMasteredBadge = document.getElementById('card-mastered-badge');
        const cardDifficultyTag = document.getElementById('card-difficulty-tag');
        const cardIndicator = document.getElementById('card-indicator');
        const progressBar = document.getElementById('progress-bar');
        const categoryFilters = document.getElementById('category-filters');
        const emptyState = document.getElementById('empty-state');
        const statsCounter = document.getElementById('stats-counter');

        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');
        const btnFlipAction = document.getElementById('btn-flip-action');
        const btnShuffle = document.getElementById('btn-shuffle');
        const btnResetMastery = document.getElementById('btn-reset-mastery');
        const btnDeleteCard = document.getElementById('btn-delete-card');
        const btnToggleMaster = document.getElementById('btn-toggle-master');

        // Modal Elements
        const modalCreate = document.getElementById('modal-create');
        const btnOpenModal = document.getElementById('btn-open-modal');
        const btnCloseModal = document.getElementById('btn-close-modal');
        const btnCancelModal = document.getElementById('btn-cancel-modal');
        const formCreateCard = document.getElementById('form-create-card');

        // Inicialização
        function init() {
            loadCards();
            renderCategoryFilters();
            filterCards(activeCategory);
            setupEventListeners();
        }

        // Carregar do LocalStorage
        function loadCards() {
            const savedCards = localStorage.getItem('dev_flashcards');
            if (savedCards) {
                try {
                    cards = JSON.parse(savedCards);
                } catch (e) {
                    cards = [...initialCards];
                }
            } else {
                cards = [...initialCards];
                saveCards();
            }
        }

        // Salvar no LocalStorage
        function saveCards() {
            localStorage.setItem('dev_flashcards', JSON.stringify(cards));
        }

        // Renderizar Filtros de Categoria
        function renderCategoryFilters() {
            const categories = ['Todos', 'JavaScript', 'Python', 'HTML/CSS', 'React', 'Lógica de Programação'];
            categoryFilters.innerHTML = '';

            categories.forEach(cat => {
                const button = document.createElement('button');
                button.className = `px-3.5 py-1.5 rounded-xl text-xs font-semibold transition border whitespace-nowrap ${
                    activeCategory === cat 
                        ? 'bg-purple-600 text-white border-purple-500 shadow-md shadow-purple-600/30' 
                        : 'bg-slate-900 hover:bg-slate-800 text-slate-300 border-slate-800'
                }`;
                button.innerText = cat;
                button.onclick = () => filterCards(cat);
                categoryFilters.appendChild(button);
            });
        }

        // Filtrar Lista
        function filterCards(category) {
            activeCategory = category;
            renderCategoryFilters();

            if (category === 'Todos') {
                filteredCards = [...cards];
            } else {
                filteredCards = cards.filter(c => c.category === category);
            }

            currentIndex = 0;
            isFlipped = false;
            updateCardUI();
        }

        function resetFilters() {
            filterCards('Todos');
        }

        // Atualizar Interface do Flashcard Atual
        function updateCardUI() {
            if (isFlipped) {
                cardInner.classList.remove('rotate-y-180');
                isFlipped = false;
            }

            statsCounter.innerText = `${cards.length} Cards Total`;

            if (filteredCards.length === 0) {
                emptyState.classList.remove('hidden');
                cardInner.classList.add('hidden');
                cardIndicator.innerText = `0 de 0`;
                progressBar.style.width = `0%`;
                btnPrev.disabled = true;
                btnNext.disabled = true;
                return;
            }

            emptyState.classList.add('hidden');
            cardInner.classList.remove('hidden');

            const currentCard = filteredCards[currentIndex];

            // Progresso
            cardIndicator.innerText = `${currentIndex + 1} de ${filteredCards.length}`;
            const progressPercent = ((currentIndex + 1) / filteredCards.length) * 100;
            progressBar.style.width = `${progressPercent}%`;

            // Botões Navegação
            btnPrev.disabled = currentIndex === 0;
            btnNext.disabled = currentIndex === filteredCards.length - 1;

            // Tema visual
            const theme = categoryThemes[currentCard.category] || categoryThemes['Default'];

            // Aplicar Estilo Frontal
            cardFront.className = `absolute inset-0 w-full h-full backface-hidden rounded-3xl p-6 sm:p-8 flex flex-col justify-between border border-white/20 card-shadow transition-all duration-300 ${theme.bg}`;
            
            // Pergunta (Frente)
            cardCategoryBadge.innerText = currentCard.category;
            cardQuestion.innerText = currentCard.question;

            if (currentCard.questionCode && currentCard.questionCode.trim() !== '') {
                cardQuestionCode.innerText = currentCard.questionCode;
                cardQuestionCode.classList.remove('hidden');
            } else {
                cardQuestionCode.classList.add('hidden');
            }

            // Dominado Badge
            if (currentCard.mastered) {
                cardMasteredBadge.classList.remove('hidden');
                btnToggleMaster.className = "text-xs font-medium px-3 py-1.5 rounded-lg border transition flex items-center gap-1.5 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border-emerald-500/40";
                btnToggleMaster.innerHTML = '<i class="fa-solid fa-check-double text-emerald-400"></i> Dominado';
            } else {
                cardMasteredBadge.classList.add('hidden');
                btnToggleMaster.className = "text-xs font-medium px-3 py-1.5 rounded-lg border transition flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border-slate-700";
                btnToggleMaster.innerHTML = '<i class="fa-solid fa-check"></i> Marcar como Dominado';
            }

            // Resposta (Verso)
            cardAnswer.innerText = currentCard.answer;

            if (currentCard.answerCode && currentCard.answerCode.trim() !== '') {
                cardAnswerCode.innerText = currentCard.answerCode;
                cardAnswerCode.classList.remove('hidden');
            } else {
                cardAnswerCode.classList.add('hidden');
            }

            // Dificuldade
            if (currentCard.difficulty === 'Facil') {
                cardDifficultyTag.className = 'text-xs font-semibold px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
                cardDifficultyTag.innerText = 'Fácil';
            } else if (currentCard.difficulty === 'Medio') {
                cardDifficultyTag.className = 'text-xs font-semibold px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30';
                cardDifficultyTag.innerText = 'Médio';
            } else if (currentCard.difficulty === 'Dificil') {
                cardDifficultyTag.className = 'text-xs font-semibold px-2.5 py-1 rounded-lg bg-red-500/20 text-red-300 border border-red-500/30';
                cardDifficultyTag.innerText = 'Difícil';
            } else {
                cardDifficultyTag.className = 'text-xs font-semibold px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 border border-slate-700';
                cardDifficultyTag.innerText = 'Não avaliado';
            }
        }

        // Girar Cartão (Flip 3D)
        function toggleFlip() {
            if (filteredCards.length === 0) return;
            isFlipped = !isFlipped;
            if (isFlipped) {
                cardInner.classList.add('rotate-y-180');
            } else {
                cardInner.classList.remove('rotate-y-180');
            }
        }

        // Autoavaliação
        function rateCard(level) {
            if (filteredCards.length === 0) return;
            const currentCard = filteredCards[currentIndex];
            currentCard.difficulty = level;
            
            const index = cards.findIndex(c => c.id === currentCard.id);
            if (index !== -1) {
                cards[index].difficulty = level;
                saveCards();
            }

            updateCardUI();

            // Avançar pro próximo automaticamente
            setTimeout(() => {
                if (currentIndex < filteredCards.length - 1) {
                    currentIndex++;
                    updateCardUI();
                }
            }, 300);
        }

        // Dominado
        function toggleMastery() {
            if (filteredCards.length === 0) return;
            const currentCard = filteredCards[currentIndex];
            currentCard.mastered = !currentCard.mastered;

            const index = cards.findIndex(c => c.id === currentCard.id);
            if (index !== -1) {
                cards[index].mastered = currentCard.mastered;
                saveCards();
            }

            updateCardUI();
        }

        // Embaralhar
        function shuffleCards() {
            if (filteredCards.length <= 1) return;
            
            for (let i = filteredCards.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [filteredCards[i], filteredCards[j]] = [filteredCards[j], filteredCards[i]];
            }

            currentIndex = 0;
            isFlipped = false;
            updateCardUI();
        }

        // Excluir Card
        function deleteCurrentCard() {
            if (filteredCards.length === 0) return;
            const currentCard = filteredCards[currentIndex];

            cards = cards.filter(c => c.id !== currentCard.id);
            saveCards();

            filterCards(activeCategory);
        }

        // Resetar Aprendizado
        function resetMastery() {
            cards.forEach(c => {
                c.mastered = false;
                c.difficulty = null;
            });
            saveCards();
            updateCardUI();
        }

        // Configurar Eventos
        function setupEventListeners() {
            cardInner.addEventListener('click', toggleFlip);
            btnFlipAction.addEventListener('click', toggleFlip);

            btnPrev.addEventListener('click', (e) => {
                e.stopPropagation();
                if (currentIndex > 0) {
                    currentIndex--;
                    updateCardUI();
                }
            });

            btnNext.addEventListener('click', (e) => {
                e.stopPropagation();
                if (currentIndex < filteredCards.length - 1) {
                    currentIndex++;
                    updateCardUI();
                }
            });

            // Teclas de atalho
            document.addEventListener('keydown', (e) => {
                if (!modalCreate.classList.contains('hidden')) return;
                
                if (e.code === 'Space') {
                    e.preventDefault();
                    toggleFlip();
                } else if (e.code === 'ArrowRight' && currentIndex < filteredCards.length - 1) {
                    currentIndex++;
                    updateCardUI();
                } else if (e.code === 'ArrowLeft' && currentIndex > 0) {
                    currentIndex--;
                    updateCardUI();
                }
            });

            btnShuffle.addEventListener('click', shuffleCards);
            btnResetMastery.addEventListener('click', resetMastery);
            btnDeleteCard.addEventListener('click', (e) => {
                e.stopPropagation();
                deleteCurrentCard();
            });
            btnToggleMaster.addEventListener('click', toggleMastery);

            // Modal
            btnOpenModal.addEventListener('click', () => modalCreate.classList.remove('hidden'));
            btnCloseModal.addEventListener('click', () => modalCreate.classList.add('hidden'));
            btnCancelModal.addEventListener('click', () => modalCreate.classList.add('hidden'));

            // Formulário
            formCreateCard.addEventListener('submit', (e) => {
                e.preventDefault();

                const newCard = {
                    id: Date.now().toString(),
                    category: document.getElementById('input-category').value,
                    question: document.getElementById('input-question').value.trim(),
                    questionCode: document.getElementById('input-question-code').value.trim(),
                    answer: document.getElementById('input-answer').value.trim(),
                    answerCode: document.getElementById('input-answer-code').value.trim(),
                    difficulty: null,
                    mastered: false
                };

                cards.unshift(newCard);
                saveCards();

                formCreateCard.reset();
                modalCreate.classList.add('hidden');

                filterCards(newCard.category);
            });
        }

        window.onload = init;
    </script>
</body>
</html>
